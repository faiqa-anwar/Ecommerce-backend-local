# Database: local Docker Postgres (docker compose up -d db) or your Supabase URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_db
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string

# Local LLM via Ollama (default values shown; you can leave these two lines as-is)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
